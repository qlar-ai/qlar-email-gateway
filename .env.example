# Qlar Email Gateway — configuration
#
# Copy to .env and fill in. Real environment variables take precedence over this file,
# so a container or systemd unit can override any line without editing it.
#
# You do not have to start here: `qlar-email-gateway enroll` with no usable configuration asks
# for the mailbox details and writes .env itself, and `run --init` asks again later.
#
# This file contains your mailbox password. Keep it mode 0600 and out of version control
# (.gitignore already excludes it). The password is never sent to Qlar.

# ---------------------------------------------------------------------------
# Qlar endpoint
# ---------------------------------------------------------------------------
# The API endpoint shown in the CMS email panel; it ends in /api/email-gateway.
QLAR_BASE_URL=

# One-time code from the Qlar CMS (agent -> Channels -> Email). Single use, expires 15 minutes
# after it is generated. Only needed for `enroll`.
QLAR_ENROLLMENT_CODE=

# Label shown in the CMS. Defaults to this machine's hostname.
#QLAR_GATEWAY_NAME=support mailbox gateway

# ---------------------------------------------------------------------------
# Mailbox
# ---------------------------------------------------------------------------
IMAP_HOST=mail.example.com
#IMAP_PORT=993
#IMAP_SECURITY=ssl              # ssl | starttls
#IMAP_FOLDER=INBOX

SMTP_HOST=mail.example.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls         # ssl | starttls

MAIL_USER=ask@example.com
MAIL_PASSWORD=
#MAIL_ADDRESS=ask@example.com   # when the address differs from the login user
#MAIL_FROM_NAME=Example Support # sender name on replies

# Check interval when the IMAP server does not support IDLE.
#POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Send guard — enforced here, Qlar cannot loosen it
# ---------------------------------------------------------------------------
# Addresses or domains that may always be emailed, comma separated: a@x.com, @corp.com, y.org
#RECIPIENT_ALLOWLIST=
# Someone who wrote to the mailbox may be answered for this many days.
#RECIPIENT_MEMORY_DAYS=30
#MAX_SENDS_PER_HOUR_PER_RECIPIENT=20

# Longest text forwarded per email, in characters.
#MAX_INBOUND_TEXT_CHARS=20000

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------
#AUDIT_LOG_FILE=./audit/mail.jsonl
#GATEWAY_KEY_FILE=./gateway-key.pem
#GATEWAY_STATE_FILE=./gateway-state.json

# Local testing against a self-signed Qlar only. Never in production.
#QLAR_INSECURE_SKIP_TLS_VERIFY=false
#LOG_LEVEL=INFO
